# Copy to .env.local and fill in. Never commit real secrets.
# On Vercel, set these in Project → Settings → Environment Variables
# (or `vercel env pull .env.local` once the project is linked).

# --- Database (Postgres: Neon or Render) -------------------------------------
# Pooled connection string used by the app at runtime.
DATABASE_URL="postgresql://user:password@host:5432/receipt_split?sslmode=require"
# Direct (non-pooled) connection string for drizzle-kit migrations. Optional;
# falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=""

# --- Vercel Blob (receipt images) --------------------------------------------
# Created automatically when you connect a Blob store to the Vercel project.
BLOB_READ_WRITE_TOKEN=""
# Hostname of your Blob store (optional if BLOB_STORE_ID is set).
# Example: abc123.public.blob.vercel-storage.com
BLOB_STORE_HOST=""
# Store id prefix from Blob URLs (becomes {id}.public.blob.vercel-storage.com).
BLOB_STORE_ID=""

# --- OCR (Vercel AI SDK via AI Gateway) --------------------------------------
# Local dev needs an AI Gateway API key. On Vercel deployments, OIDC auth is
# used automatically and this can be left unset.
AI_GATEWAY_API_KEY=""
# Any vision-capable model id from the AI Gateway model list, "provider/model".
OCR_MODEL="openai/gpt-5-mini"
# Set to "tesseract" to fall back to offline OCR if the vision call fails.
OCR_FALLBACK="tesseract"
# Hard cap for OCR work inside /api/ocr (ms). Must stay below the route maxDuration.
OCR_TIMEOUT_MS="45000"

# --- Auth (milestone 2: Better Auth) -----------------------------------------
# BETTER_AUTH_SECRET=""   # generate with: openssl rand -base64 32
# BETTER_AUTH_URL="http://localhost:3000"
